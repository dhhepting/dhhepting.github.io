# Minimal pbrt-v4 scene: one diffuse sphere, sky + sun.
LookAt 0 1 5   0 0 0   0 1 0
Camera "perspective" "float fov" 40

Sampler "zsobol" "integer pixelsamples" 64
Film "rgb" "integer xresolution" 640 "integer yresolution" 480
     "string filename" "sphere.exr"

WorldBegin

LightSource "infinite" "rgb L" [0.3 0.35 0.45]
LightSource "distant" "point3 from" [-1 2 1] "point3 to" [0 0 0]
            "rgb L" [3 3 3]

AttributeBegin
  Material "diffuse" "rgb reflectance" [0.8 0.3 0.2]
  Shape "sphere" "float radius" 1
AttributeEnd

AttributeBegin
  Material "diffuse" "rgb reflectance" [0.6 0.6 0.6]
  Translate 0 -1 0
  Shape "bilinearmesh"
        "point3 P" [-10 0 -10  10 0 -10  -10 0 10  10 0 10]
        "integer indices" [0 1 2 3]
AttributeEnd
